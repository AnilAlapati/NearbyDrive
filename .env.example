# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Firebase Integration:
# Provide these keys in the Secrets panel inside Google AI Studio to sync shared drives and bookings to your own Firebase project.
# Since we initialize Firebase programmatically, no google-services.json upload is required!
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_APPLICATION_ID="YOUR_FIREBASE_APP_ID"
